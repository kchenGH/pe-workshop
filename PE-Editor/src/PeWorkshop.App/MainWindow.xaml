<Window x:Class="PeWorkshop.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PeWorkshop.App"
 Title="PE Workshop" Width="1400" Height="900" MinWidth="1050" MinHeight="680"
 WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Background="{StaticResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#181E28" BorderBrush="#2C3645" BorderThickness="0,0,0,1" MinHeight="68">
   <Grid Margin="20,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#377FDF" CornerRadius="6" Width="35" Height="35" Margin="0,0,11,0"><TextBlock Text="PE" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="PE Workshop" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="PORTABLE EXECUTABLE EDITOR" FontSize="9" Foreground="#92A4BC" Margin="0,2,0,0"/></StackPanel>
     <local:HelpBadge TopicKey="PE"/>
    </StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Margin="0,3,10,3"><Button x:Name="OpenButton" Content="Open file" Click="Open_Click" ToolTip="Open an executable or library (Ctrl+O)"/><local:HelpBadge TopicKey="Open"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,14,3"><Button x:Name="SaveButton" Content="Save copy" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save to another path (Ctrl+Shift+S)" IsEnabled="False"/><local:HelpBadge TopicKey="SaveCopy"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,8,3"><Button x:Name="UndoButton" Content="↶" FontSize="18" Padding="12,3" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" IsEnabled="False"/><local:HelpBadge TopicKey="Undo"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,18,3"><Button x:Name="RedoButton" Content="↷" FontSize="18" Padding="12,3" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" IsEnabled="False"/><local:HelpBadge TopicKey="Redo"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,18,3"><TextBlock x:Name="DirtyLabel" Text="No file loaded" Foreground="#A0AEC0" VerticalAlignment="Center"/><local:HelpBadge TopicKey="Unsaved"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Button x:Name="ChecksumButton" Content="Update checksum" Click="Checksum_Click" IsEnabled="False" ToolTip="Calculate and write the PE checksum as an undoable edit"/><local:HelpBadge TopicKey="UpdateChecksum"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="10,3,0,3"><Button x:Name="CompareButton" Content="Compare files" Click="Compare_Click"/><local:HelpBadge TopicKey="Compare"/></StackPanel>
    </WrapPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#171D27" BorderBrush="#2C3645" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="23,27,20,17"><TextBlock Text="EXPLORER" Foreground="#7F92AA" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SidebarFile" Text="No binary open" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/><TextBlock x:Name="SidebarFormat" Text="PE32 · PE32+" Foreground="#8B9DB5" FontSize="11" Margin="0,5,0,0"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="18,20"><TextBlock Text="LOCAL WORKSPACE" Foreground="#73879F" FontSize="9"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="Fixed-size binary editing" Foreground="#8B9DB5" FontSize="10" VerticalAlignment="Center"/><local:HelpBadge TopicKey="FixedSize"/></StackPanel><TextBlock Text="Hover or click i for help" Foreground="#8B9DB5" FontSize="10" Margin="0,8,0,0"/><TextBlock Text="v1.3" Foreground="#64788F" FontSize="10" Margin="0,6,0,0"/></StackPanel>
     <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" SelectedIndex="0" Style="{StaticResource NavigationList}" ItemContainerStyle="{StaticResource NavigationItem}" IsEnabled="False">
      <ListBoxItem Tag="Overview"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Overview"/><TextBlock Text="Overview" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Headers"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Headers"/><TextBlock Text="Headers" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Sections"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Sections"/><TextBlock Text="Sections" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Directories"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Directories"/><TextBlock Text="Data directories" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Imports"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Imports"/><TextBlock Text="Imports" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Exports"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Exports"/><TextBlock Text="Exports" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Variables"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Variables"/><TextBlock Text="Variables" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Hex"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Hex"/><TextBlock Text="Hex editor" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
      <ListBoxItem Tag="Changes"><DockPanel><local:HelpBadge DockPanel.Dock="Right" TopicKey="Changes"/><TextBlock Text="Changes" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="28,23,28,20">
    <Grid x:Name="WelcomePanel">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="630" Margin="30">
      <TextBlock Text="INSPECT. UNDERSTAND. EDIT." Foreground="#73AEFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock Text="A closer look at your binaries." FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Explore Windows executables and libraries, inspect their structure, and make precise changes down to the byte." Foreground="#9CACBF" FontSize="15" LineHeight="24" TextWrapping="Wrap" Margin="0,15,0,30"/>
      <Border BorderBrush="#354B67" BorderThickness="1" CornerRadius="8" Background="#182231" Padding="30">
       <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Drop a PE file here" FontSize="19" FontWeight="SemiBold"/><local:HelpBadge TopicKey="PE"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20"><TextBlock Text=".exe  ·  .dll  ·  .sys  ·  .ocx  ·  .efi" FontFamily="Consolas" Foreground="#91A8C5" VerticalAlignment="Center"/><local:HelpBadge TopicKey="Extensions"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Browse files" Style="{StaticResource PrimaryButton}" Click="Open_Click" MinWidth="148"/><local:HelpBadge TopicKey="Browse"/></StackPanel>
       </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Explore PE Workshop itself →" Click="OpenSelf_Click" Background="Transparent" BorderThickness="0" Foreground="#8FBFFF" Padding="0,12"/><local:HelpBadge TopicKey="ExploreSelf"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="Explore debug symbols →" Click="OpenDebugSample_Click" Background="Transparent" BorderThickness="0" Foreground="#8FBFFF" Padding="0,12"/><local:HelpBadge TopicKey="VariablesSample"/></StackPanel>
      <TextBlock Text="Files stay on your computer. Edits are saved as a separate copy." Foreground="#73879F" FontSize="11" Margin="0,17,0,0"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="DocumentPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="WORKSPACE  /  BINARY INSPECTOR" Foreground="#748AA6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <Grid Grid.Row="1" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="PageTitle" Text="Binary overview" FontSize="27" FontWeight="SemiBold"/><local:HelpBadge x:Name="PageHelp" TopicKey="Overview" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="PageSubtitle" Foreground="#96A7BD" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel>
      <DockPanel Grid.Column="1" VerticalAlignment="Top"><local:HelpBadge x:Name="FilterHelp" TopicKey="Filter" DockPanel.Dock="Right"/>
      <TextBox x:Name="FilterBox" Grid.Column="1" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip="Filter rows by any displayed value (Ctrl+F)" TextChanged="Filter_TextChanged" AutomationProperties.Name="Filter inspection rows">
       <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
         <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="3">
          <Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="Filter rows…   Ctrl+F" Foreground="#6F87A5" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
         </Border>
         <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></TextBox.Style>
      </TextBox>
      </DockPanel>
     </Grid>
     <ContentControl x:Name="ViewHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Border x:Name="InspectorPanel" Grid.Row="3" Background="#1A2330" BorderBrush="#30415A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Button x:Name="RevealButton" Content="View in hex" Click="Reveal_Click"/><local:HelpBadge x:Name="RevealHelp" TopicKey="Reveal" Margin="6,0,12,0"/>
        <Button x:Name="EditButton" Content="Edit value" Click="Edit_Click" Style="{StaticResource PrimaryButton}"/><local:HelpBadge x:Name="EditHelp" TopicKey="Edit"/>
       </StackPanel>
       <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center"><StackPanel><DockPanel><local:HelpBadge x:Name="SelectionHelp" DockPanel.Dock="Right"/><TextBlock x:Name="SelectionTitle" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock x:Name="SelectionDescription" Foreground="#96AAC4" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#1B2533" BorderBrush="#304052" BorderThickness="0,1,0,0">
   <DockPanel Margin="15,0"><local:HelpBadge TopicKey="FileSize" DockPanel.Dock="Right"/><TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="#8CA7C8" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Ready · Open a file to begin" Foreground="#B0C1D7" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/></DockPanel>
  </Border>
 </Grid>
</Window>
